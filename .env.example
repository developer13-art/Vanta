NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=false
DB_POOL_MAX=20

JWT_ACCESS_SECRET=change-me-min-32-chars-xxxxxxxxxxxx
JWT_REFRESH_SECRET=change-me-different-min-32-chars-yyyyy
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENC_KEY_BASE64=

APP_BASE_URL=http://localhost:5173

METAAPI_TOKEN=
METAAPI_BASE_URL=https://mt-client-api-v1.new-york.agiliumtrade.ai
METAAPI_PROVISIONING_BASE_URL=https://mt-provisioning-api-v1.agiliumtrade.agiliumtrade.ai
FXAPIS_API_KEY=
FXAPIS_API_BASE_URL=https://api.fxapis.com
FXAPIS_ACCOUNT_MODE=warm_on_demand

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@vantatrade.ai

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=NGN

# Optional: enable Flutterwave checkout and signed webhooks.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_CURRENCIES=NGN,USD,GBP,EUR,GHS,KES,UGX,TZS,RWF,ZAR

# Optional: enable Stripe card checkout and signed webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Bank transfers are exposed only for currencies enabled here and in the Stripe dashboard.
STRIPE_BANK_TRANSFER_CURRENCIES=USD,EUR,GBP,JPY,MXN

# Daily USD exchange-rate feed used to convert credit package prices.
PAYMENT_FX_API_URL=https://open.er-api.com/v6/latest/USD

JOB_POLL_INTERVAL_MS=2000
JOB_BATCH_SIZE=5
LOG_LEVEL=info

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Required for AI Adaptive bots to analyze and recommend trades.
AI_ENABLED=false
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000