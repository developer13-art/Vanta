NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=false
DB_POOL_MAX=20

JWT_ACCESS_SECRET=change-me-min-32-chars-xxxxxxxxxxxx
JWT_REFRESH_SECRET=change-me-different-min-32-chars-yyyyy
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENC_KEY_BASE64=

APP_BASE_URL=http://localhost:5173

METAAPI_TOKEN=
METAAPI_BASE_URL=https://mt-client-api-v1.new-york.agiliumtrade.ai
